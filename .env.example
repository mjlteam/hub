SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=sqlite:///main.db
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional fixed callback URL. If empty, the app uses the host/scheme of the
# current request, so open the app with the same host registered at GitHub.
# No trailing slash is allowed.
GITHUB_REDIRECT_URI=
# Set this only when running behind a trusted reverse proxy that sends
# X-Forwarded-* headers (for example nginx or a platform proxy).
TRUST_PROXY=false
# Optional local development host for `python run.py --debug`.
# FLASK_HOST=localhost
